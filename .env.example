# Copy this file to .env and fill in your real values. Never commit .env.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=MongoDb URI
DB_NAME=DB Name

# Payment gateway: Razorpay hosted checkout
PAYMENT_GATEWAY_MODE=razorpay

# Get these from Razorpay Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=Razor Pay ID
RAZORPAY_KEY_SECRET=Razor Pay Secret

# ---------------------------------------------------------------------------
# Admin account — set these BEFORE the first run to auto-create the single
# predefined admin. Leave ADMIN_PASSWORD blank to skip creating one for now.
# The admin logs in through the same screen as regular users.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin_password

# ---------------------------------------------------------------------------
# Email OTP (registration verification + forgot password)
# Leave SMTP_HOST/SMTP_USER/SMTP_PASSWORD blank to use dev mode, where the
# OTP is printed to the console instead of emailed — handy while testing.
# Example values for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<a 16-character App Password,
# NOT your normal Gmail password — generate one at myaccount.google.com/apppasswords>
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Email_ID
SMTP_PASSWORD=Password
SMTP_FROM_EMAIL=email_from_address
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=
